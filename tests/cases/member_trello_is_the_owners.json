  "session_id": "member_trello_is_the_owners",
  "debug": true,
  "reset_before": true,
  "as": {
    "uid": "uid-DRYRUN-ana",
    "email": "ana.torres@example.com"
  },
  "turns": [
    {
      "n": 1,
      "message": "sube las tareas de Onebox2026 a Trello",
      "assert": {
        "tool_call_count": {
          "create_trello_board": 0
        },
        "response_matches": [
          "(?i)(due[ñn]o|propietari|owner|responsable del proyecto|l[ií]der)"
        ],
        "response_not_matches": [
          "(?i)(he subido|tarjetas creadas|ya est[aá]n en trello)",
          "(?i)(conecta|conectar|vincula|vincular) (primero )?(tu|su) (cuenta de )?trello"
        ]
      }
    },
    {
      "n": 2,
      "message": "y si creo yo el tablero para el proyecto?",
      "assert": {
        "tool_call_count": {
          "create_trello_board": 0
        },
        "response_matches": [
          "(?i)(due[ñn]o|propietari|owner|responsable del proyecto|l[ií]der)"
        ],
        "response_not_matches": [
