# OneBox backend configuration. Copy to .env and fill in the values.
# NEVER commit a real .env: it is in .dockerignore and must stay out of git.

# ─────────────────────────────────────────────────────────────────────────
# WHICH MODEL RUNS WHICH GRAPH NODE
# ─────────────────────────────────────────────────────────────────────────
# Format: provider[:model]   provider = anthropic | gemini | bedrock
# Leave a line out and the node uses the routing table in llm_factory.py,
# which is the same thing these four lines say. They are written here so the
# routing is visible where the rest of the configuration lives.
#
# Why this split (measured 2026-09-21/22, not guessed):
#   planner  - 14k tokens of prompt, nested output, the only node whose
#              output is EXECUTED. On gemini-2.5-flash it failed 8 of 12
#              calls; on gemini-2.5-pro it marked the WRONG task as done.
#              On anthropic it ran a full test session with none of that.
#   the rest - ~1k tokens of prompt, flat output anchored by enums:
#              0 failures in 10 calls, 0.3-2.0 s each, and much cheaper.
NODE_LLM_PLANNER=anthropic
NODE_LLM_CONTEXT_RESOLVER=gemini:gemini-2.5-flash
NODE_LLM_VALIDATOR=gemini:gemini-2.5-flash
NODE_LLM_NARRATOR=gemini:gemini-2.5-flash

# Everything OUTSIDE the graph: document analysis, insights, Gmail
# classification (agent/llm.py). The four nodes above ignore this.
LLM_PROVIDER=gemini

# Models used when a line above names a provider without one.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────
# MEASUREMENT SWITCHES (leave commented out in normal operation)
# ─────────────────────────────────────────────────────────────────────────
# Force ONE provider on all four nodes. Beats the four lines above.
# LLM_PROVIDER_ALL=gemini:gemini-2.5-flash

# Turn the fallback chain off. Required for an honest A/B: with fallbacks on,
# a provider that fails every call still produces correct answers -- someone
# else's -- and the comparison measures nothing.
# LLM_FALLBACKS=off

# Gemini 2.5 thinks by default and those tokens come out of maxOutputTokens.
# Unset: 0 (off) on flash, nothing sent on other models (2.5-pro rejects 0).
# Set to -1 for dynamic, or a token cap (0..24576 on flash).
# GEMINI_THINKING_BUDGET=0

# ─────────────────────────────────────────────────────────────────────────
# CREDENTIALS  (values are placeholders -- never commit the real ones)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AWS_REGION=us-east-1

# Shared secret EventBridge sends as header x-cron-secret to /api/scheduled/*
CRON_SECRET=

# Member updates: 'hora de actualizar' email (hour UTC from which it is sent), daily digest hour, app link
UPDATE_REMINDER_HOUR_UTC=12
UPDATES_DIGEST_HOUR_UTC=22
APP_URL=https://www.oneboxmanager.com

# Sender of every OneBox email (must be verified in SES). Default: onebox@oneboxmanager.com
SES_FROM_EMAIL=onebox@oneboxmanager.com
